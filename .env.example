# ---------------------------------------------------------------------------
# InkFlow runtime configuration
# Copy to .env (never commit .env) or set these as real environment variables.
# ---------------------------------------------------------------------------

# INKFLOW_INIT_KEY — one-time first-run initialization key (SEC-006)
# Required ONLY to create the first owner account. Must be at least 24 characters.
# Generate a strong random value, e.g.:
#   openssl rand -hex 32
# After the owner is initialized, remove this variable and restart the service.
INKFLOW_INIT_KEY=

# PORT — HTTP listen port (default 3000)
PORT=3000

# INKFLOW_DATA_DIR — where Markdown, SQLite and assets are stored (default ./storage)
# INKFLOW_DATA_DIR=/var/lib/inkflow

# INKFLOW_DB_PATH — optional explicit SQLite file path (overrides INKFLOW_DATA_DIR)
# INKFLOW_DB_PATH=/var/lib/inkflow/database/knowledge_hub.sqlite

# INKFLOW_TRUST_PROXY — only set when running behind Nginx/CDN/reverse proxy,
# so rate limiting sees real client IPs. Use the number of proxy hops (e.g. 1).
# INKFLOW_TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Optional AI Studio / Gemini integration
# ---------------------------------------------------------------------------
# GEMINI_API_KEY="MY_GEMINI_API_KEY"
# APP_URL="MY_APP_URL"
